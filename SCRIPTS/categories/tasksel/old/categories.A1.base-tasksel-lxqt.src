#!/bin/bash

## ########################################################################## ##
## Debian packages:
## tasksel
##   (-> apt-get update)
##   -> apt -a show task-lxqt-desktop
##      Depends:    task-desktop, sddm-theme-debian-elarun | sddm-theme, sddm,
##                  lxqt
##      Recommends: xsane, orca, libreoffice-gtk3, libreoffice-qt5, synaptic,
##                  libreoffice-writer, libreoffice-calc, libreoffice-impress,
##                  libreoffice-help-en-us, mythes-en-us, hunspell-en-us,
##                  hyphen-en-us, system-config-printer
##
##     task-desktop => categories.A2.base-tasksel-desktop.src
## ########################################################################## ##
myCLASS_DIR=(
"TASKSEL"
"TASKSEL_RECOMMENDS"
"EXTENDED"
)

myPACKAGE_LIST_TASKSEL=(
#Name                                         Beschreibung
#============================================-================================================================================
## task-lxqt-desktop:
## selected sddm-theme:
sddm-theme-debian-elarun                    # 'Debian Elarun' Theme for SDDM X11 display manager
sddm                                        # Moderner Displaymanager für X11
lxqt                                        # metapackage for LXDE
)

myPACKAGE_LIST_TASKSEL_RECOMMENDS=(
#Name                                         Beschreibung
#============================================-================================================================================
## task-lxde-desktop:
xsane                                       # Grafische Oberfläche für SANE (Scanner Access Now Easy) mit vielen Fähigkeiten
orca                                        # Programmierbarer Screen-Reader
#libreoffice-gtk3                            # Büroprogrammsammlung -- GTK+-3-Integration
#libreoffice-qt5                             # office productivity suite -- Qt 5 integration
synaptic                                    # Grafischer Paket-Verwalter
#libreoffice-writer                          # Büroprogrammsammlung -- Textverarbeitung
#libreoffice-calc                            # Büroprogrammsammlung -- Tabellenkalkulation
#libreoffice-impress                         # Büroprogrammsammlung -- Präsentation
#libreoffice-help-en-us                      # Büroprogrammsammlung -- Hilfe in amerikanischem Englisch
#mythes-en-us                                # English (USA) Thesaurus for LibreOffice
#hunspell-en-us                              # Hunspell-Wörterbuch für amerikanisches Englisch
#hyphen-en-us                                # English (US) hyphenation patterns
system-config-printer                       # Grafische Oberfläche für die Einrichtung des Drucksystems
)

## no part of the tasksel packages for lxqt
myPACKAGE_LIST_EXTENDED=(
#Name                                         Beschreibung
#============================================-================================================================================

)

## ########################################################################## ##
