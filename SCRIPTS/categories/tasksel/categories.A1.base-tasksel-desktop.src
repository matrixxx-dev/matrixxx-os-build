#!/bin/bash

## ########################################################################## ##
## Debian packages:
## tasksel
##   (-> apt-get update)
##   -> apt -a show task-desktop
##      Depends:    tasksel (= 3.86), desktop-base
##      Recommends: task-*-desktop(s)
##                  (* gnome xfce kde lxde gnome-flashback cinnamon mate lxqt
##                   lomiri phosh)
##                  xdg-utils, fonts-symbola, avahi-daemon, libnss-mdns,
##                  anacron, eject, iw, alsa-utils, sudo, cups
##
## ########################################################################## ##
myCLASS_DIR=(
"TASKSEL"
"TASKSEL_RECOMMENDS"
)

myPACKAGE_LIST_TASKSEL=(
#Name                                         Beschreibung
#============================================-================================================================================
## task-desktop:
desktop-base                                # Allgemeine Dateien für den Debian-Desktop
)

myPACKAGE_LIST_TASKSEL_RECOMMENDS=(
#Name                                         Beschreibung
#============================================-================================================================================
## task-desktop:
xdg-utils                                   # Desktop-Integrationsprogramme von freedesktop.org
fonts-symbola                               # Symbolschrift mit Emoji-Zeichen aus Unicode 9.0
avahi-daemon                                # Avahi mDNS/DNS-SD-Daemon
libnss-mdns                                 # NSS-Modul für die Auflösung von Multicast-DNS-Namen
anacron                                     # cron-ähnliches Programm, das sich nicht nach der Zeit richtet
eject                                       # ejects CDs and operates CD-Changers under Linux
iw                                          # Konfigurationswerkzeug für kabellose Linux-Geräte
alsa-utils                                  # Dienstprogramme für Konfiguration und Verwendung von ALSA
sudo                                        # Gewährt begrenzte Root-Privilegien für bestimmte Benutzer
cups                                        # Common UNIX Printing System(tm) - PPD-/Treiber-Unterstützung, Webschnittstelle
)

## ########################################################################## ##
