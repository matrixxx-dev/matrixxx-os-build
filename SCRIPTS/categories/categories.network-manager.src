myCLASS_DIR=(
"INSTALL"
)

## INSTALL
myPACKAGE_LIST_INSTALL=(
#Name                                         Beschreibung
#============================================-================================================================================
network-manager                             # network management framework (daemon and userspace tools)
network-manager-gnome                       # network management framework (GNOME frontend)
network-manager-openconnect                 # Rahmenwerk zur Netzwerkverwaltung (OpenConnect-Erweiterung)
network-manager-openconnect-gnome           # Rahmenwerk zur Netzwerkverwaltung (GNOME-GUI für das OpenConnect-Plugin)
network-manager-openvpn                     # Rahmenwerk zur Netzwerkverwaltung (Kern der OpenVPN-Erweiterung)
network-manager-openvpn-gnome               # network management framework (OpenVPN plugin GNOME GUI)
network-manager-pptp                        # Rahmenwerk zur Netzwerkverwaltung (Kern der PPTP-Erweiterung)
network-manager-pptp-gnome                  # network management framework (PPTP plugin GNOME GUI)
network-manager-vpnc                        # Rahmenwerk zur Netzwerkverwaltung (Kern der VPNC-Erweiterung)
network-manager-vpnc-gnome                  # network management framework (VPNC plugin GNOME GUI)
)

