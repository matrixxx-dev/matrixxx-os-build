#!/bin/bash

## ########################################################################## ##
## Debian packages:
## - no systemd
## - difference between debootstrap "variant=minbase" and "variant="
## apt-get install --yes --no-install-recommends
##
## ########################################################################## ##
## check diff.:
## -> debootstrap --print-debs --variant=minbase stable ./test > debootstrap-minibase.txt
## -> debootstrap --print-debs stable ./test > debootstrap.txt
## ########################################################################## ##
myCLASS_DIR=(
"INSTALL_SYSVINIT"
"INSTALL_DEBOOTSTRAP"
)

myPACKAGE_LIST_INSTALL_SYSVINIT=(
#Name                                         Beschreibung
