#!/bin/bash

## ########################################################################## ##
## Debian packages:
## apt-get install --yes --no-install-recommends
##
## ########################################################################## ##
myCLASS_DIR=(
"INSTALL"
"INSTALL_INITRDFS"
"INSTALL_SYSTEM_INIT"
"INSTALL_SYSTEM_BUILD"
"INSTALL_SYSTEM"
"INSTALL_SYSTEM_GRAPHIC"
"INSTALL_SYSTEM_NETWORK"
"INSTALL_SYSTEM_PRINTING"
"INSTALL_KERNEL_BUILD_ENVIRONMENT"
)

## - tools for base init phase
myPACKAGE_LIST_INSTALL_INITRDFS=(
#Name                                         Beschreibung
#============================================-================================================================================
cryptsetup-bin                              # Unterstützung für Festplattenverschlüsselung - Kommandozeilenwerkzeuge
dialog                                      # Displays user-friendly dialog boxes from shell scripts
dosfstools                                  # utilities for making and checking MS-DOS FAT filesystems
kbd                                         # Hilfsprogramme für Tastaturbelegung und Linux-Konsolenschriftart
                                            # - contains loadkeys
                                            # - note: loadkeys is replaced by loadkmap and binary key map file *.bmap in initrdfs
reiserfsprogs                               # Anwenderprogramme für ReiserFS-Dateisystem
rsync                                       # fast, versatile, remote (and local) file-copying tool
syslinux                                    # Sammlung von Boot-Loadern (Boot-Loader für DOS FAT und NTFS)
syslinux-common                             # Sammlung von Boot-Loadern (gemeinsame Dateien)
)

## - tools for init the system (matrixxx)
myPACKAGE_LIST_INSTALL_SYSTEM_INIT=(
#Name                                         Beschreibung
#============================================-================================================================================
at-spi2-core                                # Assistive Technology Service Provider Interface (dbus core)
aumix                                       # Simple text-based mixer control program
dbus                                        # Einfaches Interprozess-Nachrichtensystem (Systemnachrichten-Bus)
                                            # dbus  {-> dbus-bin dbus-daemon{-> dbus-session-bus-common} } dbus-system-bus-common
dbus-1-doc                                  # Einfaches Interprozess-Nachrichtensystem (Dokumentation)
dbus-x11                                    # Einfaches Interprozess-Nachrichtensystem (X11-Abhängigkeiten)
cgroup-tools                                # Steuerung und Überwachung von »Control Groups« (Werkzeuge)
keyutils                                    # Linux Key Management Utilities
net-tools                                   # NET-3 networking toolkit
nfs-common                                  # NFS support files common to client and server
upower                                      # Abstraktion für Energieverwaltung
)

## - tools for building a system (matrixxx)
myPACKAGE_LIST_INSTALL_SYSTEM_BUILD=(
#Name                                         Beschreibung
#============================================-================================================================================
qemu-utils                                  # QEMU utilities (includes qemu-nbd and qemu-img for handling 'network block devices')
)

